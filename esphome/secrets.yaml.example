# Copy to esphome/secrets.yaml (gitignored) and fill in. Generate the API key
# and OTA password yourself, e.g.
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"

wifi_ssid: CHANGE_ME
wifi_password: CHANGE_ME
api_encryption_key: CHANGE_ME # 32 random bytes, base64
ota_password: CHANGE_ME
